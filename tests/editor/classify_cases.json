{
  "_format": [
    "Contract tests for tsql::editor::Classify (include/tsql/editor.hpp); run by tests/editor/test_completion.cpp.",
    "Case fields: id, version (GrammarName), sql, expect: [{text, nth (1-based occurrence of text in sql, default 1),",
    "class (a TokenClass name or an array of acceptable ones)}]. Every byte of that occurrence must be covered by spans",
    "of an accepted class. Invariants checked on every result: spans are non-empty, sorted, contiguous and cover the",
    "whole input exactly (empty input: no spans)."
  ],
  "cases": [
    {"id": "basic-select", "version": "TSql170",
     "sql": "SELECT o.OrderID, COUNT(*) AS Cnt FROM dbo.Orders AS o WHERE o.Status = 1 GROUP BY o.OrderID;",
     "expect": [{"text": "SELECT", "class": "Keyword"}, {"text": "OrderID", "class": "Identifier"}, {"text": "COUNT", "class": "BuiltinFunction"}, {"text": "AS", "class": "Keyword"}, {"text": "Cnt", "class": "Identifier"}, {"text": "FROM", "class": "Keyword"}, {"text": "dbo", "class": "Identifier"}, {"text": "Orders", "class": "Identifier"}, {"text": "WHERE", "class": "Keyword"}, {"text": "=", "class": "Operator"}, {"text": "1", "class": "Number"}, {"text": ";", "class": "Punctuation"}, {"text": ",", "class": "Punctuation"}, {"text": "(", "class": "Punctuation"}, {"text": ")", "class": "Punctuation"}, {"text": " ", "class": "Whitespace"}, {"text": "GROUP", "class": "Keyword"}, {"text": "BY", "class": "Keyword"}, {"text": ".", "class": ["Punctuation", "Operator"]}, {"text": "*", "class": ["Operator", "Punctuation"]}]},
    {"id": "variables-and-types", "version": "TSql170",
     "sql": "DECLARE @since datetime2(3) = '2024-01-01', @n int = 0x1F;",
     "expect": [{"text": "DECLARE", "class": "Keyword"}, {"text": "@since", "class": "Variable"}, {"text": "datetime2", "class": "DataType"}, {"text": "3", "class": "Number"}, {"text": "'2024-01-01'", "class": "String"}, {"text": "@n", "class": "Variable"}, {"text": "int", "class": "DataType"}, {"text": "0x1F", "class": "Number"}]},
    {"id": "comments", "version": "TSql170",
     "sql": "-- header\n/* block\n   comment */ SELECT 1 -- trailing",
     "expect": [{"text": "-- header", "class": "Comment"}, {"text": "/* block\n   comment */", "class": "Comment"}, {"text": "SELECT", "class": "Keyword"}, {"text": "-- trailing", "class": "Comment"}]},
    {"id": "nested-block-comment", "version": "TSql170",
     "sql": "/* a /* b */ c */ SELECT 1",
     "expect": [{"text": "/* a /* b */ c */", "class": "Comment"}, {"text": "SELECT", "class": "Keyword"}]},
    {"id": "quoted-identifiers", "version": "TSql170",
     "sql": "SELECT [Line Total], \"Weight (kg)\" FROM dbo.[Order Details];",
     "expect": [{"text": "[Line Total]", "class": "QuotedIdentifier"}, {"text": "\"Weight (kg)\"", "class": "QuotedIdentifier"}, {"text": "[Order Details]", "class": "QuotedIdentifier"}, {"text": "dbo", "class": "Identifier"}]},
    {"id": "strings-utf8", "version": "TSql170",
     "sql": "SELECT N'Größe', 'It''s' FROM dbo.Products",
     "expect": [{"text": "N'Größe'", "class": "String"}, {"text": "'It''s'", "class": "String"}, {"text": "FROM", "class": "Keyword"}, {"text": "Products", "class": "Identifier"}]},
    {"id": "unicode-identifier", "version": "TSql170",
     "sql": "SELECT Größe = 1, x FROM t",
     "expect": [{"text": "Größe", "class": "Identifier"}, {"text": "x", "class": "Identifier"}, {"text": "FROM", "class": "Keyword"}, {"text": "t", "class": "Identifier"}]},
    {"id": "numbers", "version": "TSql170",
     "sql": "SELECT 1, 1.5, 2e10, $12.50, -3",
     "expect": [{"text": "1", "class": "Number"}, {"text": "1.5", "class": "Number"}, {"text": "2e10", "class": "Number"}, {"text": "$12.50", "class": "Number"}, {"text": "-", "class": "Operator"}, {"text": "3", "class": "Number"}]},
    {"id": "operators", "version": "TSql170",
     "sql": "SELECT * FROM t WHERE a >= 1 AND b <> 2 OR c != 3 AND d + e > f",
     "expect": [{"text": ">=", "class": "Operator"}, {"text": "<>", "class": "Operator"}, {"text": "!=", "class": "Operator"}, {"text": "+", "class": "Operator"}, {"text": "AND", "class": "Keyword"}, {"text": "OR", "class": "Keyword"}]},
    {"id": "offset-fetch", "version": "TSql170",
     "sql": "SELECT * FROM dbo.Orders ORDER BY OrderDate OFFSET 10 ROWS FETCH NEXT 5 ROWS ONLY;",
     "expect": [{"text": "OFFSET", "class": "Keyword"}, {"text": "ROWS", "class": "Keyword"}, {"text": "FETCH", "class": "Keyword"}, {"text": "NEXT", "class": "Keyword"}, {"text": "ROWS", "nth": 2, "class": "Keyword"}, {"text": "ONLY", "class": "Keyword"}, {"text": "OrderDate", "class": "Identifier"}]},
    {"id": "set-statistics", "version": "TSql170",
     "sql": "SET STATISTICS IO, TIME ON;",
     "expect": [{"text": "SET", "class": "Keyword"}, {"text": "STATISTICS", "class": "Keyword"}, {"text": "IO", "class": "Keyword"}, {"text": "TIME", "class": "Keyword"}, {"text": "ON", "class": "Keyword"}]},
    {"id": "set-options", "version": "TSql170",
     "sql": "SET NOCOUNT ON;\nSET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;",
     "expect": [{"text": "NOCOUNT", "class": "Keyword"}, {"text": "TRANSACTION", "class": "Keyword"}, {"text": "ISOLATION", "class": "Keyword"}, {"text": "LEVEL", "class": "Keyword"}, {"text": "READ", "class": "Keyword"}, {"text": "UNCOMMITTED", "class": "Keyword"}]},
    {"id": "go-separator", "version": "TSql170",
     "sql": "SELECT 1\nGO\nSELECT 2",
     "expect": [{"text": "GO", "class": "Keyword"}, {"text": "SELECT", "nth": 2, "class": "Keyword"}, {"text": "2", "class": "Number"}]},
    {"id": "window-clause-160", "version": "TSql160",
     "sql": "SELECT SUM(TotalDue) OVER w FROM dbo.Orders WINDOW w AS (PARTITION BY CustomerID);",
     "expect": [{"text": "SUM", "class": "BuiltinFunction"}, {"text": "OVER", "class": "Keyword"}, {"text": "WINDOW", "class": "Keyword"}, {"text": "PARTITION", "class": "Keyword"}, {"text": "CustomerID", "class": "Identifier"}, {"text": "w", "class": "Identifier"}]},
    {"id": "context-words-as-identifiers", "version": "TSql160",
     "sql": "SELECT window, date, Status, Name FROM dbo.Log;",
     "expect": [{"text": "window", "class": "Identifier"}, {"text": "date", "class": "Identifier"}, {"text": "Status", "class": "Identifier"}, {"text": "Name", "class": "Identifier"}, {"text": "Log", "class": "Identifier"}]},
    {"id": "table-hints", "version": "TSql170",
     "sql": "SELECT * FROM dbo.Orders WITH (NOLOCK, INDEX(IX_Orders_Customer));",
     "expect": [{"text": "WITH", "class": "Keyword"}, {"text": "NOLOCK", "class": "Keyword"}, {"text": "INDEX", "class": "Keyword"}, {"text": "IX_Orders_Customer", "class": "Identifier"}]},
    {"id": "query-hints", "version": "TSql170",
     "sql": "SELECT * FROM dbo.Orders OPTION (RECOMPILE, MAXDOP 1);",
     "expect": [{"text": "OPTION", "class": "Keyword"}, {"text": "RECOMPILE", "class": "Keyword"}, {"text": "MAXDOP", "class": "Keyword"}, {"text": "1", "class": "Number"}]},
    {"id": "cast-convert-types", "version": "TSql170",
     "sql": "SELECT CAST(OrderID AS varchar(10)), CONVERT(nvarchar(max), Notes, 1) FROM t",
     "expect": [{"text": "CAST", "class": ["BuiltinFunction", "Keyword"]}, {"text": "varchar", "class": "DataType"}, {"text": "CONVERT", "class": ["BuiltinFunction", "Keyword"]}, {"text": "nvarchar", "class": "DataType"}, {"text": "max", "class": ["DataType", "Keyword"]}, {"text": "Notes", "class": "Identifier"}]},
    {"id": "user-vs-builtin-functions", "version": "TSql170",
     "sql": "SELECT dbo.fn_OrderTotal(OrderID), GETDATE(), ISNULL(TotalDue, 0), STRING_AGG(Name, ',') FROM dbo.Orders;",
     "expect": [{"text": "fn_OrderTotal", "class": "Identifier"}, {"text": "GETDATE", "class": "BuiltinFunction"}, {"text": "ISNULL", "class": "BuiltinFunction"}, {"text": "STRING_AGG", "class": "BuiltinFunction"}, {"text": "','", "class": "String"}]},
    {"id": "global-variables", "version": "TSql170",
     "sql": "SELECT @@ROWCOUNT, @@SPID;",
     "expect": [{"text": "@@ROWCOUNT", "class": ["Variable", "BuiltinFunction"]}, {"text": "@@SPID", "class": ["Variable", "BuiltinFunction"]}]},
    {"id": "temp-table-ddl", "version": "TSql170",
     "sql": "CREATE TABLE #work (Id int NOT NULL, Amount decimal(18, 2) NULL);",
     "expect": [{"text": "CREATE", "class": "Keyword"}, {"text": "TABLE", "class": "Keyword"}, {"text": "#work", "class": "Identifier"}, {"text": "Id", "class": "Identifier"}, {"text": "int", "class": "DataType"}, {"text": "NOT", "class": "Keyword"}, {"text": "NULL", "class": "Keyword"}, {"text": "decimal", "class": "DataType"}, {"text": "18", "class": "Number"}, {"text": "NULL", "nth": 2, "class": "Keyword"}]},
    {"id": "table-variable", "version": "TSql170",
     "sql": "DECLARE @t TABLE (Id int, Amount money);",
     "expect": [{"text": "@t", "class": "Variable"}, {"text": "TABLE", "class": "Keyword"}, {"text": "int", "class": "DataType"}, {"text": "money", "class": "DataType"}]},
    {"id": "exec-parameters", "version": "TSql170",
     "sql": "EXEC dbo.usp_GetOrders @CustomerID = 42, @Since = N'2024-01-01' OUTPUT;",
     "expect": [{"text": "EXEC", "class": "Keyword"}, {"text": "usp_GetOrders", "class": "Identifier"}, {"text": "@CustomerID", "class": "Variable"}, {"text": "42", "class": "Number"}, {"text": "N'2024-01-01'", "class": "String"}, {"text": "OUTPUT", "class": "Keyword"}]},
    {"id": "create-index", "version": "TSql170",
     "sql": "CREATE NONCLUSTERED INDEX IX_Orders_Customer ON dbo.Orders (CustomerID) INCLUDE (TotalDue) WITH (ONLINE = ON, DATA_COMPRESSION = PAGE);",
     "expect": [{"text": "NONCLUSTERED", "class": "Keyword"}, {"text": "INDEX", "class": "Keyword"}, {"text": "IX_Orders_Customer", "class": "Identifier"}, {"text": "ON", "nth": 2, "class": "Keyword"}, {"text": "INCLUDE", "class": "Keyword"}, {"text": "ONLINE", "class": "Keyword"}, {"text": "ON", "nth": 4, "class": "Keyword"}, {"text": "DATA_COMPRESSION", "class": "Keyword"}, {"text": "PAGE", "class": "Keyword"}, {"text": "TotalDue", "class": "Identifier"}]},
    {"id": "merge", "version": "TSql170",
     "sql": "MERGE dbo.Products AS tgt USING staging.ProductFeed AS src ON tgt.ProductID = src.ProductID WHEN MATCHED THEN UPDATE SET tgt.ListPrice = src.ListPrice;",
     "expect": [{"text": "MERGE", "class": "Keyword"}, {"text": "USING", "class": "Keyword"}, {"text": "WHEN", "class": "Keyword"}, {"text": "MATCHED", "class": "Keyword"}, {"text": "THEN", "class": "Keyword"}, {"text": "tgt", "class": "Identifier"}, {"text": "src", "class": "Identifier"}]},
    {"id": "cte-and-window", "version": "TSql170",
     "sql": "WITH ranked AS (SELECT OrderID, ROW_NUMBER() OVER (PARTITION BY CustomerID ORDER BY OrderDate DESC) AS rn FROM dbo.Orders)\nSELECT * FROM ranked WHERE rn = 1;",
     "expect": [{"text": "WITH", "class": "Keyword"}, {"text": "ranked", "class": "Identifier"}, {"text": "ROW_NUMBER", "class": "BuiltinFunction"}, {"text": "OVER", "class": "Keyword"}, {"text": "PARTITION", "class": "Keyword"}, {"text": "DESC", "class": "Keyword"}, {"text": "rn", "class": "Identifier"}, {"text": "ranked", "nth": 2, "class": "Identifier"}]},
    {"id": "unterminated-string", "version": "TSql170",
     "sql": "SELECT 'abc",
     "expect": [{"text": "SELECT", "class": "Keyword"}, {"text": "'abc", "class": ["String", "Error"]}]},
    {"id": "unterminated-comment", "version": "TSql170",
     "sql": "SELECT 1 /* abc",
     "expect": [{"text": "1", "class": "Number"}, {"text": "/* abc", "class": ["Comment", "Error"]}]},
    {"id": "unterminated-bracket", "version": "TSql170",
     "sql": "SELECT [abc",
     "expect": [{"text": "[abc", "class": ["QuotedIdentifier", "Error"]}]},
    {"id": "invalid-character", "version": "TSql170",
     "sql": "SELECT ` FROM t",
     "expect": [{"text": "`", "class": "Error"}, {"text": "FROM", "class": "Keyword"}]},
    {"id": "empty-input", "version": "TSql170",
     "sql": "",
     "expect": []},
    {"id": "whitespace-only", "version": "TSql170",
     "sql": "  \n\t",
     "expect": [{"text": "  \n\t", "class": "Whitespace"}]},
    {"id": "crlf", "version": "TSql170",
     "sql": "SELECT 1\r\nFROM t",
     "expect": [{"text": "\r\n", "class": "Whitespace"}, {"text": "FROM", "class": "Keyword"}]},
    {"id": "fabricdw-basic", "version": "TSqlFabricDW",
     "sql": "SELECT TOP (5) o.OrderID FROM dbo.Orders AS o;",
     "expect": [{"text": "TOP", "class": "Keyword"}, {"text": "5", "class": "Number"}, {"text": "OrderID", "class": "Identifier"}]},
    {"id": "tsql130-basic", "version": "TSql130",
     "sql": "SELECT TOP (5) o.OrderID FROM dbo.Orders AS o;",
     "expect": [{"text": "TOP", "class": "Keyword"}, {"text": "5", "class": "Number"}, {"text": "OrderID", "class": "Identifier"}]},
    {"id": "is-distinct-from-160", "version": "TSql160",
     "sql": "SELECT * FROM t WHERE a IS DISTINCT FROM b;",
     "expect": [{"text": "IS", "class": "Keyword"}, {"text": "DISTINCT", "class": "Keyword"}, {"text": "FROM", "nth": 2, "class": "Keyword"}, {"text": "b", "class": "Identifier"}]},
    {"id": "perf-tuning-script", "version": "TSql170",
     "sql": "SET STATISTICS IO, TIME ON;\nGO\nDBCC FREEPROCCACHE;\nCHECKPOINT;\nSELECT TOP (10) d.ProductID, SUM(d.Quantity) AS Units\nFROM dbo.[Order Details] AS d WITH (NOLOCK)\nGROUP BY d.ProductID\nORDER BY Units DESC\nOPTION (RECOMPILE, MAXDOP 1);\nWAITFOR DELAY '00:00:01';",
     "expect": [{"text": "GO", "class": "Keyword"}, {"text": "DBCC", "class": "Keyword"}, {"text": "FREEPROCCACHE", "class": ["Keyword", "Identifier"]}, {"text": "CHECKPOINT", "class": "Keyword"}, {"text": "TOP", "class": "Keyword"}, {"text": "SUM", "class": "BuiltinFunction"}, {"text": "Units", "class": "Identifier"}, {"text": "[Order Details]", "class": "QuotedIdentifier"}, {"text": "NOLOCK", "class": "Keyword"}, {"text": "Units", "nth": 2, "class": "Identifier"}, {"text": "DESC", "class": "Keyword"}, {"text": "RECOMPILE", "class": "Keyword"}, {"text": "MAXDOP", "class": "Keyword"}, {"text": "WAITFOR", "class": "Keyword"}, {"text": "DELAY", "class": "Keyword"}, {"text": "'00:00:01'", "class": "String"}]},
    {"id": "utf8-offsets", "version": "TSql170",
     "sql": "SELECT u.Betrag AS [Größe €] FROM Reporting.dbo.Umsätze AS u -- Größe\nWHERE u.Jahr = 2024",
     "expect": [{"text": "Betrag", "class": "Identifier"}, {"text": "[Größe €]", "class": "QuotedIdentifier"}, {"text": "Umsätze", "class": "Identifier"}, {"text": "AS", "nth": 2, "class": "Keyword"}, {"text": "-- Größe", "class": "Comment"}, {"text": "\n", "class": "Whitespace"}, {"text": "WHERE", "class": "Keyword"}, {"text": "2024", "class": "Number"}]},
    {"id": "batch-after-error-batch", "version": "TSql170",
     "sql": "SELECT 1;\n)\nGO\nSET NOCOUNT ON",
     "expect": [{"text": "SET", "class": "Keyword"}, {"text": "NOCOUNT", "class": "Keyword"}, {"text": "ON", "class": "Keyword"}]}
  ]
}
